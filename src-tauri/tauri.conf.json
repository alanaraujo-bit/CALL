{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CALL",
  "version": "0.10.3",
  "identifier": "br.com.call.app",
  "build": {
    "beforeDevCommand": "npm run preparar:audio",
    "beforeBuildCommand": "npm run preparar:audio",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CALL",
        "width": 1080,
        "height": 700,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0e0f11",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost ws://*:* wss://*:* https://*.livekit.cloud"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["call"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/alanaraujo-bit/CALL/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5NkREMEQ4QjIyRjcwRgpSV1FQOXlLTERkMldCYU5pcTBMWWpOM1hYTm1ZVG0wRWxlcE9STWdmUEdUZHppUHlwQk9lSlRTdAo=",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "externalBin": ["binaries/sinalizacao"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "nsis/cabecalho.bmp",
        "sidebarImage": "nsis/lateral.bmp"
      }
    }
  }
}
